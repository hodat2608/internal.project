   </size>
  </property>
  <property name="windowTitle">
   <string>YOLOv11 Studio - Detect / Training / Auto Label / Crop</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* =====================================================================
   YOLO Studio - Soft slate light theme
   bg #EDF0F3 | card #F9FAFB | border #D2D8DE | text #2F3A45
   accent #52718F | ok #3F6A4B | ng #8A4540
   ===================================================================== */
QMainWindow, QWidget#centralwidget,
QWidget#tabDetect, QWidget#tabTraining, QWidget#tabAutoLabel, QWidget#tabCrop,
QWidget#panelViewer, QWidget#panelRight, QWidget#panelTrainLeft,
QWidget#panelAlLeft, QWidget#panelAlRight, QWidget#panelCropLeft, QWidget#panelCropRight,
QWidget#scrollContents { background: #EDF0F3; }

QWidget { color: #2F3A45; font-family: &quot;Segoe UI&quot;, &quot;Roboto&quot;, &quot;Arial&quot;; font-size: 10pt; }
QToolTip { background: #2F3A45; color: #F4F6F8; border: 0; padding: 5px 8px; }

/* ---------- Header ---------- */
QFrame#headerBar { background: #F9FAFB; border: 0; border-bottom: 1px solid #D2D8DE; }
QLabel#lblLogo { background: #52718F; color: #FFFFFF; border-radius: 9px; font-size: 16pt; font-weight: 700; }
QLabel#lblAppTitle { font-size: 14pt; font-weight: 700; color: #2B3C4E; }
QLabel#lblAppSubtitle { color: #7B8793; font-size: 9pt; }

/* ---------- Tabs ---------- */
QTabWidget::pane { border: 0; border-top: 1px solid #D2D8DE; background: #EDF0F3; top: -1px; }
QTabWidget::tab-bar { left: 16px; }
QTabBar { background: transparent; }
QTabBar::tab { background: transparent; color: #66727E; padding: 11px 26px; margin-right: 4px;
               border: 0; border-bottom: 3px solid transparent; font-weight: 600; min-width: 110px; }
QTabBar::tab:hover { color: #34506B; background: #E3E8ED; }
QTabBar::tab:selected { color: #2F4A64; border-bottom: 3px solid #52718F; background: #F9FAFB; }

/* ---------- Cards / group boxes ---------- */
QFrame[role=&quot;card&quot;] { background: #F9FAFB; border: 1px solid #D2D8DE; border-radius: 8px; }
QFrame[role=&quot;vline&quot;] { background: #D2D8DE; border: 0; }
QGroupBox { background: #F9FAFB; border: 1px solid #D2D8DE; border-radius: 8px;
            margin-top: 13px; padding: 16px 12px 12px 12px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left;
                   left: 14px; padding: 0 8px; color: #34506B; background: #EDF0F3; }
QGroupBox QLabel, QGroupBox QLineEdit, QGroupBox QSpinBox, QGroupBox QDoubleSpinBox,
QGroupBox QComboBox, QGroupBox QPushButton, QGroupBox QPlainTextEdit, QGroupBox QTableWidget,
QGroupBox QProgressBar { font-weight: 400; }

/* ---------- Labels ---------- */
QLabel { background: transparent; }
QLabel:disabled { color: #A3ADB7; }
QLabel[role=&quot;hint&quot;] { color: #7B8793; font-size: 9pt; }
QLabel[role=&quot;filename&quot;] { color: #55616D; }
QLabel[role=&quot;index&quot;] { font-weight: 700; color: #34506B; }
QLabel[role=&quot;viewer&quot;] { background: #2F353D; border-radius: 8px; color: #97A2AD; font-size: 11pt; }
QLabel[role=&quot;status-neutral&quot;], QLabel[role=&quot;status-warn&quot;], QLabel[role=&quot;status-ok&quot;] {
    border-radius: 6px; padding: 6px 12px; border: 1px solid; }
QLabel[role=&quot;status-neutral&quot;] { background: #E8ECF0; color: #55616D; border-color: #D2D8DE; }
QLabel[role=&quot;status-warn&quot;]    { background: #F3E3E1; color: #8A4540; border-color: #E4C9C6; }
QLabel[role=&quot;status-ok&quot;]      { background: #E1ECE3; color: #3F6A4B; border-color: #C5D9CA; }
QLabel[role=&quot;judge&quot;], QLabel[role=&quot;judge-ok&quot;], QLabel[role=&quot;judge-ng&quot;] {
    border-radius: 8px; padding: 12px; font-size: 16pt; font-weight: 700; border: 1px solid; }
QLabel[role=&quot;judge&quot;]    { background: #E8ECF0; color: #66727E; border-color: #D2D8DE; }
QLabel[role=&quot;judge-ok&quot;] { background: #E1ECE3; color: #3F6A4B; border-color: #C5D9CA; }
QLabel[role=&quot;judge-ng&quot;] { background: #F3E3E1; color: #8A4540; border-color: #E4C9C6; }

/* ---------- Inputs ---------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #FFFFFF; border: 1px solid #C7CFD7; border-radius: 5px;
    padding: 5px 8px; min-height: 20px; selection-background-color: #BCCDDC; selection-color: #1F2D3A; }
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover { border-color: #9FB0C0; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border: 1px solid #52718F; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background: #F0F2F4; color: #A3ADB7; border-color: #DDE2E7; }
QLineEdit[readOnly=&quot;true&quot;] { background: #F3F5F7; }
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 20px; }
QComboBox::drop-down { width: 24px; }
QComboBox QAbstractItemView { background: #FFFFFF; border: 1px solid #C7CFD7; outline: 0;
    selection-background-color: #DCE5EE; selection-color: #26364A; }

/* ---------- Buttons ---------- */
QPushButton { background: #FFFFFF; color: #34414E; border: 1px solid #BFC8D1; border-radius: 6px;
              padding: 7px 18px; min-height: 20px; font-weight: 500; }
QPushButton:hover { background: #EEF2F6; border-color: #9FB0C0; }
QPushButton:pressed { background: #E0E7EE; }
QPushButton:focus { border: 1px solid #52718F; }
QPushButton:disabled { background: #F0F2F4; color: #A3ADB7; border-color: #DDE2E7; }
QPushButton[role=&quot;primary&quot;] { background: #52718F; color: #FFFFFF; border: 1px solid #46637F;
                              font-weight: 600; padding: 9px 24px; }
QPushButton[role=&quot;primary&quot;]:hover { background: #46637F; }
QPushButton[role=&quot;primary&quot;]:pressed { background: #3B546B; }
QPushButton[role=&quot;primary&quot;]:disabled { background: #AFBDCA; border-color: #A3B2C0; color: #F2F5F8; }
QPushButton[role=&quot;nav&quot;] { padding: 6px 14px; min-width: 56px; }

/* ---------- Tables ---------- */
QTableWidget { background: #FFFFFF; alternate-background-color: #F5F7F9; border: 1px solid #D2D8DE;
               border-radius: 6px; gridline-color: #E5E9ED; outline: 0;
               selection-background-color: #DCE5EE; selection-color: #26364A; }
QTableWidget::item { border: 0; }
QHeaderView { background: #E7EBEF; border: 0; }
QHeaderView::section { background: #E7EBEF; color: #3E4C5A; font-weight: 600; padding: 7px 4px;
                       border: 0; border-right: 1px solid #D8DEE4; border-bottom: 1px solid #C9D1D9; }
QTableCornerButton::section { background: #E7EBEF; border: 0; }

/* ---------- Log / text ---------- */
QPlainTextEdit { background: #FBFCFD; border: 1px solid #D2D8DE; border-radius: 6px; padding: 6px;
                 font-family: &quot;Cascadia Mono&quot;, &quot;Consolas&quot;, &quot;DejaVu Sans Mono&quot;, monospace; font-size: 9pt;
                 selection-background-color: #BCCDDC; selection-color: #1F2D3A; }

/* ---------- Progress ---------- */
QProgressBar { background: #DCE2E8; border: 0; border-radius: 7px; text-align: center;
               color: #2F3A45; min-height: 14px; max-height: 14px; font-size: 8pt; }
QProgressBar::chunk { background: #6A89A6; border-radius: 7px; }

/* ---------- Scrollbars ---------- */
QScrollArea { background: transparent; border: 0; }
QScrollBar:vertical { background: transparent; width: 12px; margin: 2px; }
QScrollBar::handle:vertical { background: #BAC3CC; border-radius: 4px; min-height: 36px; }
QScrollBar::handle:vertical:hover { background: #98A5B1; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 2px; }
QScrollBar::handle:horizontal { background: #BAC3CC; border-radius: 4px; min-width: 36px; }
QScrollBar::handle:horizontal:hover { background: #98A5B1; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- Splitter / status bar ---------- */
QSplitter::handle { background: transparent; }
QStatusBar { background: #E4E8EC; color: #4A5662; border-top: 1px solid #D0D6DC; }
QStatusBar::item { border: 0; }</string>
