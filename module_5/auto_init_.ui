<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1100</width>
    <height>873</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>MBC Vision Inspector</string>
  </property>
  <property name="windowIcon">
   <iconset>
    <normaloff>../module_3/assert/icon/product-display.png</normaloff>../module_3/assert/icon/product-display.png</iconset>
  </property>
  <property name="styleSheet">
   <string notr="true">
* { font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;, &quot;Roboto&quot;, &quot;Helvetica Neue&quot;, Arial, sans-serif; }
QMainWindow, QWidget#centralwidget { background-color: #F1F5F9; }
QWidget#tab, QWidget#tab_2, QWidget#tab_3 { background-color: #F1F5F9; }
QToolTip { background-color: #0F172A; color: #F8FAFC; border: 1px solid #334155; padding: 6px 8px; }

/* ---------- application header ---------- */
QFrame#frame_app_header {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0B1E36, stop:1 #0F3B63);
    border: none; border-radius: 12px;
}
QLabel#label_app_logo {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #38BDF8, stop:1 #0284C7);
    color: #FFFFFF; border-radius: 10px; font-size: 12pt; font-weight: 800;
}
QLabel#label_app_title { color: #FFFFFF; font-size: 18pt; font-weight: 700; background: transparent; }
QLabel#label_app_subtitle { color: #9CC3E6; font-size: 11pt; background: transparent; }
QLabel#label_status_mysql, QLabel#label_status_plc {
    background-color: #1E3350; color: #94A3B8; border: 1px solid #2B4668;
    border-radius: 11px; padding: 3px 14px; font-size: 10pt; font-weight: 700;
}
QLabel#label_status_mysql[state=&quot;online&quot;], QLabel#label_status_plc[state=&quot;online&quot;] {
    background-color: #0B3D31; color: #6EE7B7; border: 1px solid #0F766E;
}

/* ---------- tabs ---------- */
QTabWidget::pane { border: none; border-top: 1px solid #CBD5E1; background: transparent; }
QTabWidget::tab-bar { left: 4px; }
QTabBar { background: transparent; }
QTabBar::tab {
    background: transparent; color: #64748B; padding: 10px 22px; margin-right: 2px;
    border: none; border-bottom: 3px solid transparent; font-size: 12pt; font-weight: 600;
}
QTabBar::tab:hover { color: #0F172A; }
QTabBar::tab:selected { color: #0369A1; border-bottom: 3px solid #0284C7; }

QMenuBar { background-color: #FFFFFF; border-bottom: 1px solid #E2E8F0; }
QStatusBar { background-color: #FFFFFF; border-top: 1px solid #E2E8F0; color: #64748B; }

/* ---------- page header ---------- */
QLabel { color: #334155; font-size: 10pt; font-weight: 400; background: transparent; }
QLabel:disabled { color: #94A3B8; }
QLabel#label_page_title_mysql, QLabel#label_page_title_plc, QLabel#label_plc_test_title {
    color: #0F172A; font-size: 16pt; font-weight: 700;
}
QLabel#label_page_sub_mysql, QLabel#label_page_sub_plc, QLabel#label_plc_test_subtitle {
    color: #64748B; font-size: 12pt;
}
QLabel#label_plc_conn_target { color: #64748B; font-size: 10pt; }
QFrame#frame_plc_test_header { background: transparent; border: none; }

QLabel#label_mysql_state, QLabel#label_plc_state, QLabel#label_plc_conn_status {
    background-color: #FEE2E2; color: #B91C1C; border: 1px solid #FCA5A5;
    border-radius: 11px; padding: 3px 14px; font-size: 10pt; font-weight: 700;
}
QLabel#label_mysql_state[state=&quot;connected&quot;], QLabel#label_plc_state[state=&quot;connected&quot;],
QLabel#label_plc_conn_status[state=&quot;connected&quot;] {
    background-color: #DCFCE7; color: #15803D; border: 1px solid #86EFAC;
}

/* ---------- cards ---------- */
QGroupBox {
    background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 10px;
    margin-top: 12px; padding: 22px 16px 16px 16px;
    font-size: 11pt; font-weight: 700; color: #0F172A;
}
QGroupBox::title {
    subcontrol-origin: margin; subcontrol-position: top left;
    left: 14px; padding: 0px 8px; color: #0369A1; background-color: #F1F5F9;
}
QGroupBox:disabled { color: #94A3B8; }
QLabel[role=&quot;section&quot;] { color: #0369A1; font-size: 10pt; font-weight: 700; padding-top: 6px; }
QLabel[role=&quot;section&quot;]:disabled { color: #94A3B8; }

/* side &quot;quick guide&quot; panels */
QFrame#frame_2, QFrame#frame {
    background-color: #F0F9FF; border: 1px solid #BAE6FD; border-radius: 10px;
}
QLabel#label_mysql_guide_title, QLabel#label_plc_guide_title { color: #0369A1; font-size: 10pt; font-weight: 700; }
QLabel#label_mysql_guide_body, QLabel#label_plc_guide_body { color: #334155; font-size: 10pt; }

/* ---------- inputs ---------- */
QLineEdit, QComboBox, QSpinBox {
    background-color: #FFFFFF; border: 1px solid #CBD5E1; border-radius: 6px;
    padding: 5px 10px; min-height: 22px; color: #0F172A; font-size: 10pt; font-weight: 400;
    selection-background-color: #0284C7; selection-color: #FFFFFF;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border: 1px solid #94A3B8; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #0284C7; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled { background-color: #F1F5F9; color: #94A3B8; border: 1px solid #E2E8F0; }
QComboBox QAbstractItemView {
    background-color: #FFFFFF; color: #0F172A; border: 1px solid #CBD5E1;
    selection-background-color: #E0F2FE; selection-color: #0369A1; outline: none;
}

QCheckBox, QRadioButton { color: #334155; font-size: 10pt; font-weight: 400; spacing: 8px; background: transparent; }
QCheckBox:disabled, QRadioButton:disabled { color: #94A3B8; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #94A3B8; border-radius: 4px; background-color: #FFFFFF; }
QCheckBox::indicator:hover { border: 1px solid #0284C7; }
QCheckBox::indicator:checked { background-color: #0284C7; border: 1px solid #0284C7; }
QCheckBox::indicator:disabled { background-color: #F1F5F9; border: 1px solid #CBD5E1; }
QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid #94A3B8; border-radius: 8px; background-color: #FFFFFF; }
QRadioButton::indicator:hover { border: 1px solid #0284C7; }
QRadioButton::indicator:checked {
    border: 1px solid #0284C7;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
                                      stop:0 #0284C7, stop:0.5 #0284C7, stop:0.56 #FFFFFF, stop:1 #FFFFFF);
}
QRadioButton::indicator:disabled { background-color: #F1F5F9; border: 1px solid #CBD5E1; }

/* ---------- buttons ---------- */
QPushButton {
    background-color: #FFFFFF; color: #334155; border: 1px solid #CBD5E1; border-radius: 6px;
    padding: 7px 18px; min-height: 20px; font-size: 10pt; font-weight: 600;
}
QPushButton:hover { background-color: #F1F5F9; border: 1px solid #94A3B8; }
QPushButton:pressed { background-color: #E2E8F0; }
QPushButton:disabled { background-color: #F1F5F9; color: #94A3B8; border: 1px solid #E2E8F0; }

QPushButton#pushButton_apply_login_setting, QPushButton#pushButton_apply_ip_add_setting_2,
QPushButton#pushButton_plc_receive {
    background-color: #0284C7; color: #FFFFFF; border: none;
}
QPushButton#pushButton_apply_login_setting:hover, QPushButton#pushButton_apply_ip_add_setting_2:hover,
QPushButton#pushButton_plc_receive:hover { background-color: #0369A1; }
QPushButton#pushButton_apply_login_setting:pressed, QPushButton#pushButton_apply_ip_add_setting_2:pressed,
QPushButton#pushButton_plc_receive:pressed { background-color: #075985; }
QPushButton#pushButton_apply_login_setting:disabled, QPushButton#pushButton_apply_ip_add_setting_2:disabled,
QPushButton#pushButton_plc_receive:disabled { background-color: #CBD5E1; color: #F8FAFC; }

QPushButton#pushButton_plc_send { background-color: #059669; color: #FFFFFF; border: none; }
QPushButton#pushButton_plc_send:hover { background-color: #047857; }
QPushButton#pushButton_plc_send:pressed { background-color: #065F46; }
QPushButton#pushButton_plc_send:disabled { background-color: #CBD5E1; color: #F8FAFC; }

QPushButton#pushButton_test_connection, QPushButton#pushButton_test_connection_3 {
    color: #0369A1; border: 1px solid #7DD3FC; background-color: #F0F9FF;
}
QPushButton#pushButton_test_connection:hover, QPushButton#pushButton_test_connection_3:hover { background-color: #E0F2FE; }
QPushButton#pushButton_test_connection:disabled, QPushButton#pushButton_test_connection_3:disabled {
    color: #94A3B8; border: 1px solid #E2E8F0; background-color: #F1F5F9;
}

QPushButton#network_setting_advanced, QPushButton#network_setting_advanced {
    color: #0369A1; border: 1px solid #7DD3FC; background-color: #F0F9FF;
}
QPushButton#network_setting_advanced:hover, QPushButton#network_setting_advanced:hover { background-color: #E0F2FE; }
QPushButton#network_setting_advanced:disabled, QPushButton#network_setting_advanced:disabled {
    color: #94A3B8; border: 1px solid #E2E8F0; background-color: #F1F5F9;
}


QPushButton#pushButton_disconnect_mysql { color: #B91C1C; border: 1px solid #FCA5A5; background-color: #FEF2F2; }
QPushButton#pushButton_disconnect_mysql:hover { background-color: #FEE2E2; }
QPushButton#pushButton_disconnect_mysql:disabled { color: #94A3B8; border: 1px solid #E2E8F0; background-color: #F1F5F9; }

/* ---------- PLC signal test ---------- */
QLineEdit#lineEdit_read_value {
    background-color: #0F172A; border: 1px solid #1E3A5F; border-radius: 8px;
    color: #38BDF8; padding: 6px 14px; min-height: 34px;
    font-family: &quot;Consolas&quot;, &quot;Cascadia Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 16pt; font-weight: 700;
}
QLineEdit#lineEdit_read_value:disabled { background-color: #1E293B; border: 1px solid #334155; color: #475569; }

QLabel#label_read_status, QLabel#label_write_result {
    background-color: #F1F5F9; color: #64748B; border: 1px solid #E2E8F0;
    border-radius: 6px; padding: 7px 12px; font-size: 10pt; font-weight: 700;
}
QLabel#label_read_status[state=&quot;ok&quot;], QLabel#label_write_result[state=&quot;ok&quot;] {
    background-color: #DCFCE7; color: #15803D; border: 1px solid #86EFAC;
}
QLabel#label_read_status[state=&quot;error&quot;], QLabel#label_write_result[state=&quot;error&quot;] {
    background-color: #FEE2E2; color: #B91C1C; border: 1px solid #FCA5A5;
}
QLabel#label_read_status[state=&quot;pending&quot;], QLabel#label_write_result[state=&quot;pending&quot;] {
    background-color: #FEF3C7; color: #B45309; border: 1px solid #FCD34D;
}
QPushButton#pushButton_plc_clear_log, QPushButton#pushButton_plc_copy_log { padding: 5px 14px; }

QTextEdit#textEdit_plc_log {
    background-color: #0F172A; color: #CBD5E1; border: 1px solid #1E293B; border-radius: 8px;
    padding: 6px; selection-background-color: #0284C7;
    font-family: &quot;Consolas&quot;, &quot;Cascadia Mono&quot;, &quot;Courier New&quot;, monospace; font-size: 10pt;
}
</string>
