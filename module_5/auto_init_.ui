            <widget class="QLabel" name="label_plc_guide_body">
             <property name="text">
              <string>1.  Pick the PLC module and connection type.

2.  Enter the PLC IP address and port.

3.  Run Test Connection, then Apply.

4.  Open “PLC Signal Test” to read and write registers.</string>
             </property>
             <property name="alignment">
