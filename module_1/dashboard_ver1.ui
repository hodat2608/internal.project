       </font>
      </property>
      <property name="styleSheet">
       <string notr="true">/* 1. Tùy biến khung nền nội dung phía dưới các tab */
QTabWidget::pane {
    border: 1px solid #3c3c3c;
    background-color: #F7FFFD;
    position: absolute;
    top: -1px; /* Giúp khung nền khít với thanh tab, không bị lộ viền đè */
    border-radius: 6px;
}

/* 2. Cấu hình thanh chứa các tab */
QTabBar {
    qproperty-drawBase: 0; /* Xóa đường viền mặc định đáng ghét dưới thanh tab */
    left: 5px; /* Tạo khoảng cách lề trái cho các tab */
}

/* 3. Phong cách chung cho TẤT CẢ các Tab */
QTabBar::tab {
    background-color: #F7FFFD;
    color: #b1b1b1;
    border: 1px solid #F7FFFD;
    border-bottom-color: none; /* Giấu viền dưới để nối liền với pane khi được chọn */
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 16px;
    margin-right: 2px;
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 12px;
}

/* 4. Hiệu ứng khi di chuột qua tab (Hover) */
QTabBar::tab:hover {
    background-color: #383838;
    color: #ffffff;
    cursor: pointer;
}

/* 5. Phong cách khi Tab ĐƯỢC CHỌN (Active) */
QTabBar::tab:selected {
    background-color: #1e1e1e; /* Trùng màu với màu nền QTabWidget::pane */
    color: #4fc3f7; /* Màu chữ xanh neon tạo điểm nhấn hi-tech */
    border-bottom-color: #1e1e1e; /* Làm chìm viền dưới để hòa vào nền */
    font-weight: bold;
}

/* 6. Rút gọn tab không được chọn để tạo chiều sâu */
QTabBar::tab:!selected {
    margin-top: 2px; /* Làm tab chưa chọn thấp xuống một chút */
}
</string>
