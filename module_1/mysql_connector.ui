/* ========== GLOBAL ========== */
QMainWindow, QWidget {
    background-color: #f5f7fa;
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 13px;
    color: #2c3e50;
}

/* ========== LOGO PANEL ========== */
QFrame#frameLogo {
    background-color: #ffffff;
    border: 1px solid #e1e5eb;
    border-radius: 10px;
}
QLabel#labelLogoTitle {
    font-size: 28px;
    font-weight: 700;
    color: #00758f;
    letter-spacing: 1px;
}
QLabel#labelLogoSub {
    font-size: 12px;
    color: #7f8c8d;
}

/* ========== FORM PANEL ========== */
QFrame#frameForm {
    background-color: #ffffff;
    border: 1px solid #e1e5eb;
    border-radius: 10px;
}
QLabel {
    color: #34495e;
}
QLabel#labelDesc {
    color: #95a5a6;
    font-size: 11px;
    font-style: italic;
}

/* ========== INPUTS ========== */
QLineEdit, QSpinBox {
    min-height: 30px;
    padding: 3px 10px;
    border: 1px solid #cdd3db;
    border-radius: 6px;
    background-color: #ffffff;
    selection-background-color: #3498db;
}
QLineEdit:hover, QSpinBox:hover {
    border-color: #3498db;
}
QLineEdit:focus, QSpinBox:focus {
    border: 1.5px solid #2980b9;
}
QLineEdit#lineEditPassword {
    /* password echo mode set in properties */
}

/* ========== BUTTONS ========== */
QPushButton {
    min-height: 32px;
    min-width: 110px;
    padding: 5px 16px;
    border: 1px solid #cdd3db;
    border-radius: 6px;
    background-color: #f8f9fb;
    color: #2c3e50;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #e8f0fe;
    border-color: #3498db;
    color: #1a73e8;
}
QPushButton:pressed {
    background-color: #d2e3fc;
}
QPushButton#btnOK {
    background-color: #00758f;
    color: white;
    border: none;
    font-weight: 600;
}
QPushButton#btnOK:hover {
    background-color: #00a3c4;
}
QPushButton#btnTest {
    background-color: #2980b9;
    color: white;
    border: none;
    font-weight: 600;
}
QPushButton#btnTest:hover {
    background-color: #3498db;
}

/* ========== CHECKBOX ========== */
QCheckBox {
    spacing: 8px;
    color: #34495e;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid #b0b8c1;
}
QCheckBox::indicator:checked {
    background-color: #00758f;
    border-color: #00758f;
}
</string>
