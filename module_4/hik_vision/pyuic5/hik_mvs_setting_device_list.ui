                    <property name="styleSheet">
                     <string notr="true">QPushButton { 
    background-color: rgb(255,102,102); /* Màu đỏ hiện đại, tươi sáng */
    border: 1px solid #d32f2f;          /* Viền đỏ đậm hơn một chút để sắc nét */
    border-radius: 4px;                 /* Giữ nguyên bo tròn 4px */
    color: white;                       /* Ép chữ sang màu trắng để nổi bật trên nền đỏ */
    font-weight: bold;                  /* Làm đậm chữ để dễ đọc hơn (Tùy chọn) */
}

/* Hiệu ứng khi di chuột qua nút (Đổi sang đỏ đậm hơn) */
QPushButton:hover { 
    background-color: rgb(230, 45, 35); 
}

/* Hiệu ứng khi ấn giữ nút (Tùy chọn để tăng trải nghiệm) */
QPushButton:pressed {
    background-color: rgb(195, 30, 22);
}
</string>
