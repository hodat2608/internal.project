               </font>
              </property>
              <property name="styleSheet">
               <string notr="true">/* Khung chính của GroupBox */
QGroupBox {
    background-color: #F7FFFD; /* Màu nền theo yêu cầu của bạn */
    border: 1px solid #000000; /* Viền xám mảnh để định hình khối */
    border-radius: 4px;        /* Bo tròn góc 4px đồng bộ với QPushButton */
    margin-top: 12px;          /* Tạo khoảng cách phía trên để nhường chỗ cho chữ tiêu đề */
    font-size: 15px;           /* Kích thước chữ tiêu đề */
    font-weight: bold;         /* Làm đậm chữ tiêu đề */
    color: #333333;            /* Màu chữ tiêu đề */
}

/* Tùy chỉnh vị trí của chữ tiêu đề GroupBox */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left; /* Đặt tiêu đề ở góc trên bên trái */
    left: 10px;                    /* Đẩy chữ dịch vào trong một chút cho đẹp */
    padding: 0px 5px;              /* Khoảng cách đệm xung quanh chữ */
}
</string>
              </property>
              <property name="title">
               <string>PC 🡮 🡬 PLC</string>
              </property>
              <layout class="QGridLayout" name="gridLayout_16">
               <item row="0" column="0">
                <layout class="QVBoxLayout" name="vlayout_plc_v">
                 <property name="spacing">
                  <number>8</number>
                 </property>
                 <item>
                  <widget class="QTableWidget" name="tableWidget">
                   <property name="minimumSize">
                    <size>
                     <width>0</width>
                     <height>260</height>
                    </size>
                   </property>
                   <property name="font">
                    <font>
                     <family>Segoe UI</family>
                     <pointsize>9</pointsize>
                    </font>
                   </property>
                   <property name="styleSheet">
                    <string notr="true">/* Khung chính của bảng TableView */
QTableView {
    background-color: #F7FFFA; /* Màu xanh lá nhạt dịu mắt (Mint Light) */
    border: 1px solid #325C62;  /* Viền xám mảnh đồng bộ */
    border-radius: 4px;         /* Bo tròn góc 4px */
    gridline-color: #d0ebd5;    /* Màu của các đường lưới ngăn cách ô (xanh lá rất nhạt) */
}

/* Màu nền của từng ô dữ liệu bên trong bảng */
QTableView::item {
    background-color: #F7FFFA; /* Đồng bộ màu xanh lá nhạt cho các ô */
    color: #2c3e50;            /* Màu chữ tối để dễ đọc */
}

/* Hiệu ứng khi di chuột qua một dòng/ô */
QTableView::item:hover {
    background-color: #F5FFE1; /* Xanh lá đậm hơn một chút khi di chuột */
}

/* Hiệu ứng khi NGƯỜI DÙNG CLICK CHỌN một dòng/ô */
QTableView::item:selected {
    background-color: #E9F8FF; /* Đổi thành màu xanh lá đậm khi được chọn */
    color: black;              /* Chữ chuyển sang trắng để nổi bật */
}
</string>
