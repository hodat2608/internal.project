                   <property name="styleSheet">
                    <string notr="true">/* Khung chính của bảng TableView */
QTableView {
    background-color: #F7FFFA; /* Màu xanh lá nhạt dịu mắt (Mint Light) */
    border: 1px solid #c6c6c6;  /* Viền xám mảnh đồng bộ */
    border-radius: 4px;         /* Bo tròn góc 4px */
    gridline-color: #d0ebd5;    /* Màu của các đường lưới ngăn cách ô (xanh lá rất nhạt) */
}

/* Màu nền của từng ô dữ liệu bên trong bảng */
QTableView::item {
    background-color: #F7FFFA; /* Đồng bộ màu xanh lá nhạt cho các ô */
    color: #2c3e50;            /* Màu chữ tối để dễ đọc */
}

/* Hiệu ứng khi di chuột qua một dòng/ô */
QTableView::item:hover {
    background-color: #F5FFE1; /* Xanh lá đậm hơn một chút khi di chuột */
}

/* Hiệu ứng khi NGƯỜI DÙNG CLICK CHỌN một dòng/ô */
QTableView::item:selected {
    background-color: #E9F8FF; /* Đổi thành màu xanh lá đậm khi được chọn */
    color: black;              /* Chữ chuyển sang trắng để nổi bật */
}
</string>
