             <item>
              <widget class="QCheckBox" name="checkBox_enable_send_data_plc">
               <property name="maximumSize">
                <size>
                 <width>70</width>
                 <height>16777215</height>
                </size>
               </property>
               <property name="font">
                <font>
                 <family>Segoe UI</family>
                 <pointsize>-1</pointsize>
                 <weight>75</weight>
                 <bold>true</bold>
                </font>
               </property>
               <property name="toolTip">
                <string>Enable send result data to PLC by resgister.</string>
               </property>
               <property name="styleSheet">
                <string notr="true">QCheckBox {
    color: #E2E8F0;
    font-size: 13px;
    spacing: 8px;
    background: transparent;
    border: none;
}

/* Ô vuông khi chưa tích chọn */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1.5px solid #64748B;
    background-color: #1E293B;
}

/* Hiệu ứng khi di chuột vào ô vuông */
QCheckBox::indicator:hover {
    border: 1.5px solid #38BDF8;
    background-color: #0F172A;
}

/* Ô vuông khi ĐÃ tích chọn */
QCheckBox::indicator:checked {
    border: 1.5px solid #3B82F6;
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5,
        fx: 0.5, fy: 0.5,
        stop: 0 #FFFFFF,
        stop: 0.45 #FFFFFF,
        stop: 0.5 #3B82F6,
        stop: 1 #3B82F6
    );
}

/* Hiệu ứng khi di chuột vào ô đã tích */
QCheckBox::indicator:checked:hover {
    border: 1.5px solid #60A5FA;
}
</string>
               </property>
