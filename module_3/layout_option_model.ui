                     <property name="styleSheet">
                      <string notr="true">QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
}
QPushButton:hover {
    background-color: rgba(0, 0, 0, 25);     /* nền hiện ra khi rê chuột */
}
QPushButton:pressed {
    background-color: rgba(0, 0, 0, 50);     /* đậm hơn khi nhấn */
}</string>
