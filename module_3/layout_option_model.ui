            <property name="styleSheet">
             <string notr="true">QLabel {
    color: #ffffff; /* Chữ màu đen xám hiện đại, tương phản cao trên nền trắng */
    
    background-color:  qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0B1E36, stop:1 #0F3B63); /* Nền màu trắng */
    border: 2px solid #7A7A7A; /* Viền xám rất nhạt để định hình khối */
    border-radius: 15px; /* Bo tròn góc mạnh hơn, tạo cảm giác mềm mại */
    
    padding: 12px 25px;
    qproperty-alignment: AlignCenter; /* Căn chữ ra chính giữa label */
}
</string>
