                     <property name="styleSheet">
                      <string notr="true">QLineEdit {
    border-radius: 8px;
    border: 2px solid #bdc3c7; /* Đường viền */
    padding: 5px 10px; /* Khoảng cách chữ với viền để không bị đè vào góc bo */
    background-color: white;
}

/* Hiệu ứng khi nhấn chuột vào ô nhập (tùy chọn) */
QLineEdit:focus {
    border: 2px solid #3498db; 
}
</string>
