      <property name="styleSheet">
       <string notr="true">/* Khung ngoài của ScrollArea */
QScrollArea {
    background-color: #F1F5F9; /* Màu vàng nhạt (Soft Yellow) */
    border: 1px solid #c6c6c6;  /* Viền xám mảnh đồng bộ */
    border-radius: 4px;         /* Bo tròn góc 4px */
}

/* BẮT BUỘC: Đổi nền của widget con bên trong sang suốt 
   để màu vàng nhạt của khung ngoài được hiển thị hoàn toàn */
QScrollArea &gt; QWidget &gt; QWidget {
    background-color: transparent;
}

/* Tùy chỉnh thanh cuộn dọc (Nếu bạn muốn tinh tế hơn) */
QScrollBar:vertical {
    background-color: #f5f5f5;
    width: 10px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #dcdde1; /* Cục kéo màu xám nhạt */
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #c6c6c6; /* Cục kéo đậm hơn khi di chuột */
}
</string>
      </property>
